{
  "ApiSettings": {
    "BaseUrl": "https://api.commandcenter.com/",
    "TimeoutSeconds": 30
  },
  "Authentication": {
    "CookieName": "CommandCenter.Auth",
    "ExpireMinutes": 480,
    "LoginPath": "/Auth/Login",
    "LogoutPath": "/Auth/Logout"
  },
  "ApplicationInsights": {
    "Enabled": false,
    "ConnectionString": ""
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
