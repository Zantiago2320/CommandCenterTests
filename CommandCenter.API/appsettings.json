{
  "ConnectionStrings": {
    "DefaultConnection": "Server=.;Database=CommandCenterDB;Trusted_Connection=True;MultipleActiveResultSets=true;TrustServerCertificate=True"
  },
  "JwtSettings": {
    "SecretKey": "CAMBIAR_POR_CLAVE_SECRETA_DE_AL_MENOS_32_CARACTERES_UNICA",
    "Issuer": "CommandCenter.API",
    "Audience": "CommandCenter.Clients",
    "ExpirationMinutes": 480,
    "RefreshTokenExpirationDays": 7
  },
  "SendGrid": {
    "ApiKey": "SENDGRID_API_KEY_AQUI",
    "FromEmail": "noreply@commandcenter.com",
    "FromName": "Command Center"
  },
  "Hangfire": {
    "DashboardPath": "/jobs",
    "WorkerCount": 5
  },
  "AzureKeyVault": {
    "VaultUri": "",
    "Enabled": false
  },
  "AzureStorage": {
    "ConnectionString": "",
    "ContainerName": "commandcenter-files",
    "Enabled": false
  },
  "ApplicationInsights": {
    "ConnectionString": "",
    "Enabled": false
  },
  "ApiSettings": {
    "Version": "v1",
    "Title": "Command Center API",
    "Description": "Plataforma corporativa de automatización interna — Command Center"
  },
  "RateLimit": {
    "RequestsPerMinute": 60
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5000",
      "http://localhost:5100",
      "https://portal.commandcenter.com"
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "Hangfire": "Warning"
    }
  },
  "AllowedHosts": "*"
}
