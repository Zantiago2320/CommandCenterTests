@page
@model ErrorModel
@{
    ViewData["Title"] = "Error";
    Layout = "_Layout";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6 text-center">
            <div class="card shadow">
                <div class="card-body p-5">
                    <i class="bi bi-exclamation-triangle-fill text-warning" style="font-size: 3rem;"></i>
                    <h2 class="mt-3">Ha ocurrido un error</h2>
                    <p class="text-muted">Ocurrió un error inesperado. Por favor intenta de nuevo o contacta al administrador.</p>
                    @if (Model.ShowRequestId)
                    {
                        <p class="small text-muted">Request ID: <code>@Model.RequestId</code></p>
                    }
                    <a href="/" class="btn btn-primary mt-3">Volver al inicio</a>
                </div>
            </div>
        </div>
    </div>
</div>
