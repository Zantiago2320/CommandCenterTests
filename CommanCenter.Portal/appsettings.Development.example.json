{
  /*
   * appsettings.Development.json — CommanCenter Portal
   * Sobreescribe appsettings.json SOLO en ambiente local (DOTNET_ENVIRONMENT=Development).
   * Este archivo NO debe subirse a producción ni contener secretos reales.
   * Agregar a .gitignore si llega a contener contraseñas o keys locales.
   */

  "ApiSettings": {
    /* URL del API corriendo localmente — debe coincidir con launchSettings.json de la API */
    "BaseUrl": "https://localhost:65002/",
    "TimeoutSeconds": 60
  },

  "Authentication": {
    /* Cookie con nombre diferente para no colisionar con sesiones de otros ambientes */
    "CookieName": "CommanCenter.Auth.Dev",
    /* Sesión más larga en DEV para no tener que re-loguearse constantemente */
    "ExpireMinutes": 1440
  },

  "ApplicationInsights": {
    /* Desactivado en DEV — no consumir créditos ni contaminar métricas de producción */
    "Enabled": false,
    "ConnectionString": ""
  },

  "Serilog": {
    "MinimumLevel": {
      /* Debug en DEV para ver trazas detalladas de requests, EF, etc. */
      "Default": "Debug",
      "Override": {
        "Microsoft": "Information",
        "System": "Warning"
      }
    }
  },

  /* Key Vault desactivado en DEV — los secretos van en User Secrets */
  "KeyVault": {
    "Enabled": false,
    "VaultUri": ""
  },

  "NotificationApi": {
    /* URL local de la Notification API cuando corre en modo desarrollo */
    "BaseUrl": "https://localhost:7002/",
    "TimeoutSeconds": 30,
    "ApiKey": ""
  },

  "AzureBlobStorage": {
    /* En local las fotos se guardan en wwwroot/uploads/ automáticamente */
    "ConnectionString": "",
    "ContainerName": "imagenes"
  }
}
